<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IgotU" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorPrimaryVariant">@color/cyan_dark</item>
        <item name="colorOnPrimary">@color/navy</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
    </style>

    <style name="Theme.IgotU.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#0D1B2A</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#0D1B2A</item>
        <item name="android:navigationBarColor">#0D1B2A</item>
    </style>

    <style name="Widget.IgotU.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/navy</item>
        <item name="backgroundTint">@color/cyan</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.IgotU.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/cyan</item>
        <item name="strokeColor">@color/cyan</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.IgotU.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/cyan</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>
